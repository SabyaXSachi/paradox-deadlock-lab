<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.paradox.controller.ProcessManagerController"
      spacing="14">
    <padding>
        <Insets top="18" right="22" bottom="18" left="22"/>
    </padding>

    <Label text="Process Manager" styleClass="view-title"/>
    <Label text="Create processes, watch their states change and terminate them."
           styleClass="view-subtitle"/>

    <HBox styleClass="form-row" spacing="10" alignment="CENTER_LEFT">
        <Label text="Name" styleClass="form-label" labelFor="$nameField"/>
        <TextField fx:id="nameField" promptText="e.g. P1" prefWidth="120"/>
        <Label text="Arrival time" styleClass="form-label" labelFor="$arrivalSpinner"/>
        <Spinner fx:id="arrivalSpinner" prefWidth="100"/>
        <Label text="Priority" styleClass="form-label" labelFor="$prioritySpinner"/>
        <Spinner fx:id="prioritySpinner" prefWidth="100"/>
        <Button text="Add process" onAction="#addProcess" styleClass="button-primary"/>
    </HBox>

    <TableView fx:id="processTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="nameColumn" text="Name" prefWidth="90"/>
            <TableColumn fx:id="arrivalColumn" text="Arrival" prefWidth="80"/>
            <TableColumn fx:id="priorityColumn" text="Priority" prefWidth="80"/>
            <TableColumn fx:id="stateColumn" text="State" prefWidth="120"/>
            <TableColumn fx:id="holdingsColumn" text="Resources held" prefWidth="420"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button text="Terminate selected" onAction="#terminateSelected"
                styleClass="button-danger"/>
        <Label text="Terminating releases all holdings and cancels pending requests."
               styleClass="hint-label"/>
    </HBox>
</VBox>
