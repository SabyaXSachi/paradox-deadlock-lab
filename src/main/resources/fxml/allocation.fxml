<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.paradox.controller.AllocationController"
      spacing="14">
    <padding>
        <Insets top="18" right="22" bottom="18" left="22"/>
    </padding>

    <Label text="Resource Allocation Engine" styleClass="view-title"/>
    <Label text="Allocate directly, request additional instances, or release holdings. Requests that cannot be granted make the process wait."
           styleClass="view-subtitle"/>

    <HBox styleClass="form-row" spacing="10" alignment="CENTER_LEFT">
        <Label text="Process" styleClass="form-label"/>
        <ComboBox fx:id="processCombo" prefWidth="180"/>
        <Label text="Resource" styleClass="form-label"/>
        <ComboBox fx:id="resourceCombo" prefWidth="200"/>
        <Label text="Instances" styleClass="form-label"/>
        <Spinner fx:id="instancesSpinner" prefWidth="90"/>
        <Button fx:id="allocateButton" text="Allocate" onAction="#allocate"
                styleClass="button-primary"/>
        <Button fx:id="requestButton" text="Request" onAction="#request"
                styleClass="button-secondary"/>
        <Button fx:id="releaseButton" text="Release" onAction="#release"
                styleClass="button-secondary"/>
    </HBox>

    <Label text="Current allocations" styleClass="section-title"/>
    <TableView fx:id="allocationTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="allocProcessColumn" text="Process" prefWidth="140"/>
            <TableColumn fx:id="allocResourceColumn" text="Resource" prefWidth="140"/>
            <TableColumn fx:id="allocInstancesColumn" text="Instances" prefWidth="100"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

    <Label text="Pending requests (waiting processes)" styleClass="section-title"/>
    <TableView fx:id="requestTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="requestProcessColumn" text="Process" prefWidth="120"/>
            <TableColumn fx:id="requestResourceColumn" text="Resource" prefWidth="120"/>
            <TableColumn fx:id="requestInstancesColumn" text="Instances" prefWidth="100"/>
            <TableColumn fx:id="requestStatusColumn" text="Status" prefWidth="110"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button text="Cancel selected request" onAction="#cancelSelectedRequest"
                styleClass="button-danger"/>
        <Label text="Cancelling returns a waiting process to the READY state."
               styleClass="hint-label"/>
    </HBox>
</VBox>
