<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.paradox.controller.BankersController"
      spacing="12">
    <padding>
        <Insets top="18" right="22" bottom="18" left="22"/>
    </padding>

    <Label text="Banker's Algorithm" styleClass="view-title"/>
    <Label text="Deadlock AVOIDANCE: grants are only advised when the state stays safe. An unsafe state is a risk, not a detected deadlock."
           styleClass="view-subtitle" wrapText="true"/>

    <Label text="Maximum-claim matrix (Need = Maximum - Allocation)" styleClass="section-title"/>
    <TableView fx:id="claimTable" accessibleText="Maximum resource claims"
                prefHeight="180"/>

    <HBox styleClass="form-row" spacing="10" alignment="CENTER_LEFT">
        <Label text="Process" styleClass="form-label" labelFor="$processCombo"/>
        <ComboBox fx:id="processCombo" prefWidth="140"/>
        <Label text="Resource" styleClass="form-label" labelFor="$resourceCombo"/>
        <ComboBox fx:id="resourceCombo" prefWidth="170"/>
        <Label text="Instances" styleClass="form-label" labelFor="$claimSpinner"/>
        <Spinner fx:id="claimSpinner" prefWidth="90"/>
        <Button text="Set max claim" onAction="#setClaim" styleClass="button-secondary"/>
        <Button text="Run safety check" onAction="#runSafetyCheck" styleClass="button-primary"/>
        <Button text="Evaluate request" onAction="#evaluateRequest"
                styleClass="button-secondary"/>
    </HBox>

    <HBox spacing="12" alignment="CENTER_LEFT">
        <Label fx:id="verdictLabel" text="Not checked yet" styleClass="status-chip"/>
        <Label fx:id="sequenceLabel" text="Safe sequence: -" styleClass="form-label"/>
    </HBox>

    <Label fx:id="messageLabel" styleClass="explanation-label" wrapText="true"/>

    <Label text="Algorithm execution - step by step" styleClass="section-title"/>
    <ListView fx:id="stepsList" accessibleText="Bankers algorithm execution steps"
              VBox.vgrow="ALWAYS"/>
</VBox>
