<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.paradox.controller.RecoveryController"
      spacing="12">
    <padding>
        <Insets top="18" right="22" bottom="18" left="22"/>
    </padding>

    <Label text="Recovery Engine" styleClass="view-title"/>
    <Label text="Recover from deadlock by terminating processes or by (simulated) resource preemption. Every action is verified by a fresh detection."
           styleClass="view-subtitle" wrapText="true"/>

    <HBox spacing="12" alignment="CENTER_LEFT">
        <Button text="Detect deadlock now" onAction="#detectNow" styleClass="button-primary"/>
        <Label fx:id="deadlockStatusLabel" text="No deadlock on record"
               styleClass="status-chip"/>
    </HBox>

    <HBox spacing="16">
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label text="Deadlocked processes" styleClass="section-title"/>
            <ListView fx:id="deadlockedList" prefHeight="130"/>
            <HBox spacing="10">
                <Button text="Terminate selected" onAction="#terminateSelected"
                        styleClass="button-danger"/>
                <Button text="Terminate ALL deadlocked" onAction="#terminateAll"
                        styleClass="button-danger"/>
            </HBox>
        </VBox>
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label text="Resource preemption (simulation)" styleClass="section-title"/>
            <HBox styleClass="form-row" spacing="10" alignment="CENTER_LEFT">
                <Label text="Victim" styleClass="form-label" labelFor="$processCombo"/>
                <ComboBox fx:id="processCombo" prefWidth="170"/>
                <Label text="Resource" styleClass="form-label" labelFor="$resourceCombo"/>
                <ComboBox fx:id="resourceCombo" prefWidth="160"/>
                <Label text="Instances" styleClass="form-label" labelFor="$instancesSpinner"/>
                <Spinner fx:id="instancesSpinner" prefWidth="85"/>
            </HBox>
            <Button text="Preempt and mark victim for rollback" onAction="#preemptSelected"
                    styleClass="button-secondary"/>
            <Label text="Preemption revokes instances and moves the victim to READY - a real OS would roll the process back or restart it."
                   styleClass="hint-label" wrapText="true"/>
        </VBox>
    </HBox>

    <Label fx:id="resultLabel" styleClass="explanation-label" wrapText="true"/>

    <Label text="Recovery log (stored in MySQL)" styleClass="section-title"/>
    <TableView fx:id="logTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="strategyColumn" text="Strategy" prefWidth="170"/>
            <TableColumn fx:id="targetColumn" text="Target" prefWidth="380"/>
            <TableColumn fx:id="successColumn" text="Success" prefWidth="80"/>
            <TableColumn fx:id="timeColumn" text="Executed at" prefWidth="170"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>
</VBox>
