<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.paradox.controller.MainController"
            prefWidth="1100" prefHeight="700">

    <top>
        <HBox styleClass="header" spacing="10" alignment="CENTER_LEFT">
            <padding>
                <Insets top="10" right="16" bottom="10" left="16"/>
            </padding>
            <Label text="PARADOX" styleClass="header-title"/>
            <Label text="Deadlock Detection and Recovery Laboratory"
                   styleClass="header-subtitle"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Simulation:" styleClass="header-label" labelFor="$simulationCombo"/>
            <ComboBox fx:id="simulationCombo" prefWidth="260"/>
            <Button text="Open" onAction="#openSelectedSimulation" styleClass="button-secondary"/>
            <Button text="New..." onAction="#createSimulation" styleClass="button-primary"/>
            <Button text="Delete" onAction="#deleteSelectedSimulation" styleClass="button-danger"/>
            <Label fx:id="openSimulationLabel" text="No simulation open" styleClass="header-status"/>
        </HBox>
    </top>

    <fx:define>
        <ToggleGroup fx:id="navigationGroup"/>
    </fx:define>

    <left>
        <VBox styleClass="sidebar" spacing="2" prefWidth="220">
            <padding>
                <Insets top="18" right="12" bottom="18" left="14"/>
            </padding>
            <ToggleButton text="Dashboard" onAction="#openDashboard" fx:id="dashboardButton"
                          toggleGroup="$navigationGroup"
                          styleClass="nav-button, nav-button-active" maxWidth="Infinity"/>
            <ToggleButton text="Process Manager" onAction="#openProcesses" fx:id="processesButton"
                          toggleGroup="$navigationGroup"
                          styleClass="nav-button" maxWidth="Infinity"/>
            <ToggleButton text="Resource Manager" onAction="#openResources" fx:id="resourcesButton"
                          toggleGroup="$navigationGroup"
                          styleClass="nav-button" maxWidth="Infinity"/>
            <ToggleButton text="Allocation Engine" onAction="#openAllocation" fx:id="allocationButton"
                          toggleGroup="$navigationGroup"
                          styleClass="nav-button" maxWidth="Infinity"/>
            <ToggleButton text="Deadlock Detection" onAction="#openDetection" fx:id="detectionButton"
                          toggleGroup="$navigationGroup"
                          styleClass="nav-button" maxWidth="Infinity"/>
            <ToggleButton text="Banker's Algorithm" onAction="#openBankers" fx:id="bankersButton"
                          toggleGroup="$navigationGroup"
                          styleClass="nav-button" maxWidth="Infinity"/>
            <ToggleButton text="Visualizer" onAction="#openVisualizer" fx:id="visualizerButton"
                          toggleGroup="$navigationGroup"
                          styleClass="nav-button" maxWidth="Infinity"/>
            <ToggleButton text="Recovery Engine" onAction="#openRecovery" fx:id="recoveryButton"
                          toggleGroup="$navigationGroup"
                          styleClass="nav-button" maxWidth="Infinity"/>
            <ToggleButton text="History" onAction="#openHistory" fx:id="historyButton"
                          toggleGroup="$navigationGroup"
                          styleClass="nav-button" maxWidth="Infinity"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Label text="Academic OS laboratory" styleClass="sidebar-footer"/>
        </VBox>
    </left>

    <center>
        <StackPane fx:id="contentPane"/>
    </center>

</BorderPane>
