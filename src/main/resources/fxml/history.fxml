<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.paradox.controller.HistoryController"
      spacing="16">
    <padding>
        <Insets top="18" right="22" bottom="18" left="22"/>
    </padding>

    <VBox spacing="8" prefWidth="400">
        <Label text="Simulation History" styleClass="view-title"/>
        <Label text="Everything stored in MySQL. Select a simulation to inspect its logs and replay its steps."
               styleClass="view-subtitle" wrapText="true"/>
        <TableView fx:id="simulationTable" accessibleText="Simulation history"
                   VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="simNameColumn" text="Name" prefWidth="170"/>
                <TableColumn fx:id="simStatusColumn" text="Status" prefWidth="100"/>
                <TableColumn fx:id="simCreatedColumn" text="Created" prefWidth="140"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
        <HBox spacing="10">
            <Button text="Refresh" onAction="#refresh" styleClass="button-secondary"/>
            <Button text="Open in laboratory" onAction="#openSelectedInLaboratory"
                    styleClass="button-primary"/>
        </HBox>
    </VBox>

    <TabPane VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS" tabClosingPolicy="UNAVAILABLE">
        <Tab text="Event log">
            <VBox spacing="8">
                <padding>
                    <Insets top="12" right="12" bottom="12" left="12"/>
                </padding>
                <ListView fx:id="eventList" accessibleText="Simulation event log"
                          VBox.vgrow="ALWAYS"/>
            </VBox>
        </Tab>
        <Tab text="Deadlock detections">
            <VBox spacing="8">
                <padding>
                    <Insets top="12" right="12" bottom="12" left="12"/>
                </padding>
                <ListView fx:id="deadlockList" accessibleText="Deadlock detection history"
                          VBox.vgrow="ALWAYS"/>
            </VBox>
        </Tab>
        <Tab text="Recovery logs">
            <VBox spacing="8">
                <padding>
                    <Insets top="12" right="12" bottom="12" left="12"/>
                </padding>
                <TableView fx:id="recoveryTable" accessibleText="Recovery history"
                           VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="recStrategyColumn" text="Strategy" prefWidth="160"/>
                        <TableColumn fx:id="recTargetColumn" text="Target" prefWidth="320"/>
                        <TableColumn fx:id="recSuccessColumn" text="Success" prefWidth="80"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
            </VBox>
        </Tab>
        <Tab text="Snapshots and replay">
            <VBox spacing="8">
                <padding>
                    <Insets top="12" right="12" bottom="12" left="12"/>
                </padding>
                <Label text="Every simulation step was snapshotted automatically. Select a step to see the full state at that moment."
                       styleClass="hint-label" wrapText="true"/>
                <ListView fx:id="snapshotList" accessibleText="Simulation snapshots"
                          prefHeight="160"/>
                <TextArea fx:id="replayArea" accessibleText="Selected snapshot details"
                          VBox.vgrow="ALWAYS" editable="false"
                          styleClass="replay-area" wrapText="true"/>
            </VBox>
        </Tab>
    </TabPane>
</HBox>
