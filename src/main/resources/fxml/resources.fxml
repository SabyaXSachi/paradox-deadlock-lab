<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.paradox.controller.ResourceManagerController"
      spacing="14">
    <padding>
        <Insets top="18" right="22" bottom="18" left="22"/>
    </padding>

    <Label text="Resource Manager" styleClass="view-title"/>
    <Label text="Resource types with their instance accounting: available + allocated = total."
           styleClass="view-subtitle"/>

    <HBox styleClass="form-row" spacing="10" alignment="CENTER_LEFT">
        <Label text="Name" styleClass="form-label"/>
        <TextField fx:id="nameField" promptText="e.g. R1" prefWidth="120"/>
        <Label text="Total instances" styleClass="form-label"/>
        <Spinner fx:id="instancesSpinner" prefWidth="100"/>
        <Button text="Add resource" onAction="#addResource" styleClass="button-primary"/>
    </HBox>

    <TableView fx:id="resourceTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="nameColumn" text="Name" prefWidth="120"/>
            <TableColumn fx:id="totalColumn" text="Total" prefWidth="110"/>
            <TableColumn fx:id="availableColumn" text="Available" prefWidth="110"/>
            <TableColumn fx:id="allocatedColumn" text="Allocated" prefWidth="110"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button text="Delete selected" onAction="#deleteSelected" styleClass="button-danger"/>
        <Label text="A resource can only be deleted while nothing is allocated from or requested for it."
               styleClass="hint-label"/>
    </HBox>
</VBox>
